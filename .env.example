APP_NAME="QR Live Wall"
APP_ENV=production
APP_URL=https://wall.example.com
APP_VERSION=1.0.0
APP_DEBUG=false

# Database: sqlite (local) or mysql (MariaDB on z.com)
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/local.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qrlivewall
DB_USER=qrlivewall_user
DB_PASS=change_me_strong_password

# Seeded Super Admin (used once during install.php)
SEED_ADMIN_USER=superadmin
SEED_ADMIN_NAME="Event Director"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASS=ChangeMeNow!2026

# Security & Privacy
APP_SECRET=replace_with_64_char_random_hex_string
SESSION_COOKIE_NAME=qrlw_session
SESSION_LIFETIME_HOURS=12
TRUST_PROXY_HEADERS=false
PROFANITY_LIST="badword1,badword2,slur1"

# Image Bank
IMAGE_BANK_QUOTA_MB=200

# Signaling: poll (recommended for shared hosting) or auto (try SSE then fallback to poll)
SIGNALING_MODE=poll

# WebRTC ICE Servers (Cloudflare Realtime TURN recommended, or static TURN_URL/TURN_USER/TURN_PASS)
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
TURN_URL=""
TURN_USER=""
TURN_PASS=""
